# Lite edition environment template. Copy to .env only if your shell loads it;
# Django does not read this file automatically.

# Development defaults are safe only for local synthetic use.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For.
DJANGO_USE_X_FORWARDED_FOR=0

# Demo seeding. If omitted, seed_demo generates random one-time passwords and
# prints them once. It never resets an existing account's password.
LITE_ADMIN_PASSWORD=
LITE_AMINA_PASSWORD=
LITE_JOHN_PASSWORD=
