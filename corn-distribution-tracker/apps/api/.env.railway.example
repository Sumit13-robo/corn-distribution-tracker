# Copy these values into the Railway service variables. Do not commit real secrets.
APP_ENV=production
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=your-service.up.railway.app,localhost,127.0.0.1
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Vercel production origin. This is also added to CORS and CSRF automatically.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Railway terminates TLS at its edge; keep Django's redirect off and trust the
# edge's X-Forwarded-Proto. X-Forwarded-For trust stays off until the edge
# behavior is independently verified.
TRUST_X_FORWARDED_PROTO=true
TRUST_X_FORWARDED_FOR=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# Private S3-compatible evidence storage. For a Railway Bucket, use the bucket
# variable references and leave STORAGE_SERVER_SIDE_ENCRYPTION empty (Railway
# buckets are encrypted at rest but do not support the S3 SSE request header).
STORAGE_MODE=s3
STORAGE_ENDPOINT_URL=${{Bucket.ENDPOINT}}
STORAGE_REGION=${{Bucket.REGION}}
STORAGE_BUCKET=${{Bucket.BUCKET}}
STORAGE_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
STORAGE_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
STORAGE_SERVER_SIDE_ENCRYPTION=
STORAGE_KMS_KEY_ID=
STORAGE_ADDRESSING_STYLE=virtual
STORAGE_SIGNED_URL_TTL_SECONDS=120
MAX_EVIDENCE_UPLOAD_BYTES=10485760
MAX_EVIDENCE_PIXELS=40000000
EVIDENCE_UPLOAD_TTL_SECONDS=900

# Gunicorn / database runtime.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-service.up.railway.app
