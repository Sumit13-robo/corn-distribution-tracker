# ---------------------------------------------------------------------------
# Corn Distribution Tracker - environment template
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# Descriptions in docs/ops/ENVIRONMENT_VARIABLES.md. Production startup fails
# fast if required secrets are missing, are left at sample values, or insecure
# cookie/CORS/storage modes are selected.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=Corn Distribution Tracker
API_V1_PREFIX=/api/v1

# PostgreSQL. The Django ORM uses NUMERIC decimals; PostGIS is not required.
DATABASE_URL=postgresql+psycopg://corn:corn@localhost:5432/corn_tracker
# 0 is safest for Django's threaded development server (and constrained/E2E
# databases). Gunicorn deployments may use 30-60.
DB_CONN_MAX_AGE=0

# High-entropy secret: openssl rand -hex 48 . Sample value below is okay only
# for local development; production startup rejects it.
SECRET_KEY=sample-development-only-secret-change-me
SESSION_TTL_DAYS=14
SESSION_COOKIE_NAME=sessionid

# Exact origins, comma separated. Never "*" together with credentials.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional single deployment origin; appended to CORS and CSRF automatically.
FRONTEND_ORIGIN=

# Cookies: production must use COOKIE_SECURE=true and SameSite=Lax|Strict.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Set these only behind a trusted TLS reverse proxy that overwrites the headers.
# TRUST_X_FORWARDED_FOR must stay false unless the app is unreachable except
# through that proxy; trusting it on a directly exposed API allows IP spoofing.
TRUST_X_FORWARDED_PROTO=false
TRUST_X_FORWARDED_FOR=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Private evidence storage. STORAGE_MODE=local is for local development and
# testing only. Production requires STORAGE_MODE=s3 and complete credentials.
STORAGE_MODE=local
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=120
# S3/MinIO server-side encryption algorithm (AES256 or aws:kms). Empty disables
# the request header; production buckets should keep encryption enabled.
STORAGE_SERVER_SIDE_ENCRYPTION=AES256
# Optional KMS key id when STORAGE_SERVER_SIDE_ENCRYPTION=aws:kms.
STORAGE_KMS_KEY_ID=
# auto (default), virtual (Railway Buckets) or path (some MinIO endpoints).
STORAGE_ADDRESSING_STYLE=auto
MAX_EVIDENCE_UPLOAD_BYTES=10485760
MAX_EVIDENCE_PIXELS=40000000
# Upload intents and their presigned URLs expire after this many seconds.
EVIDENCE_UPLOAD_TTL_SECONDS=900
ALLOWED_EVIDENCE_CONTENT_TYPES=image/jpeg,image/png,image/webp
LOCAL_STORAGE_DIR=./storage-data
PUBLIC_BASE_URL=http://localhost:8000

# Browser-visible configuration. Only public values may use the VITE_ prefix.
VITE_API_BASE_URL=/api/v1
# Public map configuration for MapLibre. Empty style uses OpenStreetMap streets
# plus an Esri satellite toggle. Set VITE_MAP_TILE_URL / VITE_MAP_SATELLITE_TILE_URL
# for your own raster providers, or VITE_MAP_STYLE_URL for a full custom style.
VITE_MAP_STYLE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_SATELLITE_TILE_URL=

# Organization defaults
ORG_TIMEZONE=Asia/Kolkata
DEFAULT_GEOFENCE_RADIUS_M=200
MAX_ACCEPTABLE_GPS_ACCURACY_M=100
MAX_LOCATION_AGE_SECONDS=300
MAX_CAPTURE_TIME_DRIFT_SECONDS=600

# Observability
LOG_LEVEL=INFO
